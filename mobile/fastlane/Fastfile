# Fastfile — ShipASO iOS build/sign/ship, on the same fastlane + match pipeline
# the sibling airowe apps use. This exists because EAS generated orphan signing
# certs whose private keys weren't in the local keychain; match pulls the shared,
# valid distribution identity (cert + private key) from the mangia-certs repo, so
# signing just works.
#
# Auth: App Store Connect API key (.p8) — no Apple ID password, no 2FA, no
# session expiry. Key lives at fastlane/AuthKey_NC235A8728.p8 (git-ignored).

default_platform(:ios)

# The one place the .ipa path is written down.
#
# `build_app`'s `output_directory: "./builds"` resolves against fastlane's
# WORKING directory, which is `mobile/` — so the artifact is
# `mobile/builds/ShipASO.ipa`. It is NOT `mobile/fastlane/builds/`, which is
# what `__dir__` would give and what the build's own success message used to
# claim. Both lanes read this rather than each spelling the path out, so they
# cannot disagree about where the binary is.
# Anchored to this file's PARENT (mobile/) rather than Dir.pwd, so the path is
# the same no matter which directory fastlane was invoked from.
def ipa_path
  File.expand_path("../builds/ShipASO.ipa", __dir__)
end

# App Store Connect API key — used for match, gym signing, and uploads.
def load_api_key
  key_file = File.expand_path("AuthKey_NC235A8728.p8", File.dirname(__FILE__))
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID", "NC235A8728"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID", "166b49fe-7da6-45ec-b392-0aa2f5d391a2"),
    key_filepath: key_file,
    in_house: false,
  )
end

# `expo prebuild` regenerates ios/ from app.config.ts; the current RN/Expo SDK
# ships React-Core prebuilt as an xcframework that must be extracted from its
# release tarball before `pod install` validates vendored_frameworks. Same
# seeding the Heathen pipeline uses. No-op once seeded.
def seed_react_prebuilt_frameworks
  UI.message("Seeding React-Core-prebuilt xcframework (if needed)…")
  sh(<<~SHELL)
    DEST="../ios/Pods/React-Core-prebuilt/React.xcframework"
    TARBALL=$(ls ../ios/Pods/ReactNativeCore-artifacts/*-release.tar.gz 2>/dev/null | head -1)
    if [ -n "$TARBALL" ] && [ ! -f "$DEST/Info.plist" ]; then
      mkdir -p "$DEST"; tar -xf "$TARBALL" --strip-components=1 -C "$DEST" 2>&1
      echo "Extracted $TARBALL"
    else echo "React-Core-prebuilt already seeded or no tarball — skipping."; fi
  SHELL
  sh(<<~SHELL)
    DEST="../ios/Pods/ReactNativeDependencies/framework/packages/react-native/ReactNativeDependencies.xcframework"
    TARBALL=$(ls ../ios/Pods/ReactNativeDependencies-artifacts/*-release.tar.gz 2>/dev/null | head -1)
    if [ -n "$TARBALL" ] && [ ! -f "$DEST/Info.plist" ]; then
      mkdir -p "$DEST"; tar -xf "$TARBALL" --strip-components=4 -C "$DEST" 2>&1
      echo "Extracted $TARBALL"
    else echo "ReactNativeDependencies already seeded or no tarball — skipping."; fi
  SHELL
end

# The RevenueCat public SDK key must be present AND look like an iOS key.
#
# `mobile/app.config.ts` reads `process.env.REVENUECAT_IOS_KEY ?? ""` during
# `expo prebuild`. Unset it and nothing fails: prebuild bakes in an empty key,
# the archive signs, the .ipa uploads, and the paywall dies at runtime with
# `Invalid API Key` — indistinguishable, to a reviewer, from "nothing is
# purchasable". That is Guideline 3.1.1, and it is what rejected 0.1.0.
#
# Four separate docs instructed the operator to export this and none enforced
# it. A build that reaches App Store Connect has already escaped; the only
# useful place to fail is here, before prebuild.
def require_revenuecat_ios_key
  key = ENV["REVENUECAT_IOS_KEY"].to_s.strip
  if key.empty?
    UI.user_error!(
      "REVENUECAT_IOS_KEY is not set. app.config.ts would bake in an empty key " \
      "and ship a dead paywall (Guideline 3.1.1 — the 0.1.0 rejection). " \
      "Run: set -a; . ../.env; set +a   then re-run this lane.",
    )
  end
  # Android and Stripe keys are non-empty and just as fatal. RevenueCat's iOS
  # public SDK keys are prefixed `appl_`.
  unless key.start_with?("appl_")
    UI.user_error!(
      "REVENUECAT_IOS_KEY does not start with `appl_` (got #{key[0, 6]}…). " \
      "That is not an iOS RevenueCat public SDK key — an Android (`goog_`) or " \
      "Stripe key builds fine and leaves the paywall dead.",
    )
  end
  UI.success("REVENUECAT_IOS_KEY present (#{key[0, 9]}…) — paywall will have a live key.")
end

platform :ios do
  before_all do
    load_api_key
  end

  desc "One-time: create ShipASO's App Store provisioning profile in the match repo (uses the existing shared cert; API-key auth, no 2FA)"
  lane :bootstrap_signing do
    api_key = load_api_key
    match(type: "appstore", api_key: api_key, readonly: false)
    UI.success("ShipASO appstore profile created + committed to the match repo. `build` (readonly) will now work.")
  end

  desc "Prebuild ios/, install pods, sync signing via match, and build a signed App Store .ipa"
  lane :build do
    # 0) Fail before doing any work if the paywall would ship dead.
    require_revenuecat_ios_key

    api_key = load_api_key

    # 1) Regenerate ios/ from app.config.ts so version/Info.plist match source.
    UI.message("expo prebuild…")
    sh("cd .. && npx expo prebuild --platform ios --no-install 2>&1")

    # 2) Pods.
    UI.message("pod install…")
    sh("cd ../ios && pod install 2>&1")
    seed_react_prebuilt_frameworks

    # 3) Signing identity from the shared match repo (cert + private key).
    match(type: "appstore", api_key: api_key, readonly: true)

    # 3b) expo prebuild generates the project with automatic signing and no team,
    #     so archiving fails with "requires a development team". Force MANUAL
    #     signing onto the match-provided profile (same as the sibling apps).
    # match exports the profile name it just synced; gym needs the SAME name in
    # `export_options` below, or the archive builds and the export silently
    # produces no .ipa (fastlane still exits 0).
    profile_name = ENV["sigh_com.shipaso.app_appstore_profile-name"]
    UI.user_error!("match did not export a profile name — cannot sign") if profile_name.to_s.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/ShipASO.xcodeproj",
      team_id: "7WWYCV9VT8",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["ShipASO"],
    )

    # 4) Build number: monotonic, minute-stamped (avoids collisions with the
    #    EAS-era remote numbers without depending on them).
    increment_build_number(
      build_number: Time.now.utc.strftime("%Y%m%d%H%M").to_i,
      xcodeproj: "ios/ShipASO.xcodeproj",
    )

    # 5) Archive + export the signed .ipa. `export_options.provisioningProfiles`
    #    is REQUIRED under manual signing — without it the archive succeeds and
    #    the export step yields no .ipa while fastlane still reports success.
    build_app(
      workspace: "ios/ShipASO.xcworkspace",
      scheme: "ShipASO",
      export_method: "app-store",
      output_directory: "./builds",
      output_name: "ShipASO.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.shipaso.app" => profile_name,
        },
      },
    )

    # Trust the artifact, not the exit code.
    #
    # NOTE the path. `output_directory: "./builds"` is relative to fastlane's
    # WORKING directory (mobile/), not to this file's directory
    # (mobile/fastlane/). Using __dir__ here checks mobile/fastlane/builds/,
    # which has never existed — the guard would fail every successful build.
    ipa = ipa_path
    UI.user_error!("build_app reported success but produced no .ipa at #{ipa}") unless File.exist?(ipa)
    UI.success("Built signed .ipa → mobile/builds/ShipASO.ipa")
  end

  desc "Upload the built .ipa to App Store Connect / TestFlight (no review submit)"
  lane :upload do
    api_key = load_api_key
    ipa = ipa_path
    UI.user_error!("No .ipa at #{ipa} — run `fastlane ios build` first") unless File.exist?(ipa)
    upload_to_testflight(
      api_key: api_key,
      ipa: "./builds/ShipASO.ipa",
      skip_waiting_for_build_processing: true,
    )
    UI.success("Uploaded to App Store Connect. Attach to the pending version in ASC when processed.")
  end

  # The sibling apps (Heathen/Mangia/snagg) ship via a single `beta` lane rather
  # than build-then-upload, so the binary that was just verified is the exact one
  # that gets uploaded — no stale .ipa can slip through from an earlier run.
  desc "Build and upload to TestFlight in one pass (the sibling-app pattern)"
  lane :beta do
    build
    upload
  end
end
